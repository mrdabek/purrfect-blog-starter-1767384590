@model PurrfectBlog.Models.BlogPost

@{
    ViewBag.Title = "Create Post";
}

<h2>Create Post</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div>
        @Html.LabelFor(m => m.Title)
        @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Title)
    </div>

    <div style="margin-top:10px;">
        @Html.LabelFor(m => m.Content)
        @Html.TextAreaFor(m => m.Content, new { @class = "form-control", rows = 6 })
        @Html.ValidationMessageFor(m => m.Content)
    </div>

    <div style="margin-top:10px;">
        @Html.LabelFor(m => m.Category)
        @Html.TextBoxFor(m => m.Category, new { @class = "form-control" })
        <small>(Optional)</small>
    </div>

    <div style="margin-top:15px;">
        <button type="submit" class="btn btn-primary">Save</button>
        @Html.ActionLink("Back to posts", "Index", "Posts", null, new { @class = "btn btn-default" })
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
